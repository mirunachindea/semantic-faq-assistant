# Copy to .env and fill in. Every variable maps to a field in src/faq_assistant/config.py.

# --- Auth: comma-separated bearer tokens (generate with: openssl rand -hex 32) ----------
API_TOKENS=change-me-api-token
ADMIN_TOKENS=change-me-admin-token

# --- Models (any LangChain provider; install the matching langchain-<provider> pkg) ---
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-...

# --- Vector store: "postgres" (pgvector) or "memory" (no database, dev only) ------------
VECTOR_STORE=postgres
DATABASE_URL=postgresql://faq:faq@localhost:5432/faq
DEFAULT_COLLECTION=faq
KNOWLEDGE_BASE_PATH=data/knowledge_base.json
SYNC_ON_STARTUP=false

# --- Routing thresholds (calibrate with `faq-admin evaluate`) ---------------------------
ACCEPT_THRESHOLD=0.85
FALLBACK_ACCEPT_THRESHOLD=0.60
CANDIDATE_THRESHOLD=0.40
LEXICAL_BOOST_WEIGHT=0.2
PERSONALIZE_ANSWERS=true

# --- Celery -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
